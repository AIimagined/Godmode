#!/bin/sh
# Runs CI's gate list and the affected tests on HEAD in a disposable worktree;
# a red result refuses the push. Installed with: cp scripts/dev/pre-push .git/hooks/pre-push
cd "$(git rev-parse --show-toplevel)" || exit 1
# A branch delete (local sha all zeros) or a tag push carries no branch code to check, so it never needs the ~30 min local run.
skip=1
saw_line=0
while read -r local_ref local_sha remote_ref remote_sha; do
    saw_line=1
    case "$remote_ref" in
        refs/tags/*) continue ;;
    esac
    case "$local_sha" in
        *[!0]*) skip=0 ;;
    esac
done
if [ "$saw_line" = 1 ] && [ "$skip" = 1 ]; then
    echo "pre-push: skipping the local run - no branch code in this push (delete/tag only)" >&2
    exit 0
fi
exec python scripts/dev/ci_local.py
