#!/usr/bin/env sh
# Thin shim so the command is `godmode ...` rather than a long interpreter
# invocation against a plugin path. Every call otherwise costs the caller the
# full path to the plugin, which is enough friction to suppress use.
#
# Put this directory on PATH, or symlink this file into one already there.
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(dirname -- "$here")

# Presence on PATH is not the same as being an interpreter: Windows ships
# `python`/`python3` shims that exist, resolve, and then refuse to run. So each
# candidate is asked for its version and only accepted if it answers.
usable() {
  command -v "$1" >/dev/null 2>&1 && "$1" -c "import sys" >/dev/null 2>&1
}

python=
if [ -n "${GODMODE_PYTHON:-}" ]; then
  python=$GODMODE_PYTHON
else
  for candidate in python3 python py; do
    if usable "$candidate"; then
      python=$candidate
      break
    fi
  done
  # Off-PATH fallbacks (2026-09-10): the same list the hook launcher walks,
  # for a terminal or host whose PATH lacks Homebrew, MacPorts, pyenv or
  # the python.org framework; stock /usr/bin/python3 last, since it is a
  # stub until the developer tools are installed.
  if [ -z "$python" ]; then
    for candidate in /opt/homebrew/bin/python3 /usr/local/bin/python3 /opt/local/bin/python3 "$HOME/.pyenv/shims/python3" /Library/Frameworks/Python.framework/Versions/Current/bin/python3 "$HOME/.local/bin/python3" /usr/bin/python3; do
      if [ -x "$candidate" ] && "$candidate" -c "import sys" >/dev/null 2>&1; then
        python=$candidate
        break
      fi
    done
  fi
fi

if [ -z "$python" ]; then
  echo "godmode: no working python interpreter found on PATH." >&2
  echo "         Set GODMODE_PYTHON to the interpreter to use." >&2
  exit 127
fi

exec "$python" "$root/scripts/godmode.py" "$@"
