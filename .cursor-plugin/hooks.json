{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" godmode_session_hook.py session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "preToolUse": [
      {
        "matcher": "Shell|Write|Delete",
        "failClosed": true,
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" godmode_gate_fast.py",
            "timeout": 3
          }
        ]
      }
    ],
    "beforeShellExecution": [
      {
        "matcher": ".*",
        "failClosed": true,
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" godmode_gate_fast.py",
            "timeout": 3
          }
        ]
      }
    ],
    "stop": [
      {
        "loop_limit": 1,
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" godmode_session_hook.py stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
