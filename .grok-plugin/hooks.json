{
  "description": "Godmode continuity + pre-tool gate for Grok's native plugin loader.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${GROK_PLUGIN_ROOT}/hooks/godmode_session_hook.py\" session-start",
            "commandWindows": "python \"${GROK_PLUGIN_ROOT}\\hooks\\godmode_session_hook.py\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${GROK_PLUGIN_ROOT}/hooks/godmode_session_hook.py\" user-prompt",
            "commandWindows": "python \"${GROK_PLUGIN_ROOT}\\hooks\\godmode_session_hook.py\" user-prompt",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|run_terminal_command|search_replace|write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${GROK_PLUGIN_ROOT}/hooks/godmode_gate_fast.py\"",
            "commandWindows": "python \"${GROK_PLUGIN_ROOT}\\hooks\\godmode_gate_fast.py\"",
            "timeout": 8
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${GROK_PLUGIN_ROOT}/hooks/godmode_session_hook.py\" pre-compact",
            "commandWindows": "python \"${GROK_PLUGIN_ROOT}\\hooks\\godmode_session_hook.py\" pre-compact",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${GROK_PLUGIN_ROOT}/hooks/godmode_session_hook.py\" session-end",
            "commandWindows": "python \"${GROK_PLUGIN_ROOT}\\hooks\\godmode_session_hook.py\" session-end",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
