{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"<ABSOLUTE-PATH-TO-GODMODE>/hooks/run-hook.cmd\" godmode_gate_fast.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"<ABSOLUTE-PATH-TO-GODMODE>/hooks/run-hook.cmd\" godmode_session_hook.py session-start"
          }
        ]
      }
    ]
  }
}
