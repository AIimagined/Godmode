{
  "description": "Load bounded Godmode continuity at session start, and decide protected tool calls at the pre-tool boundary.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/godmode_session_hook.py",
              "session-start"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/godmode_session_hook.py",
              "user-prompt"
            ],
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|NotebookEdit|apply_patch|functions.exec|shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/godmode_gate_fast.py"
            ],
            "timeout": 3
          }
        ]
      }
    ]
  }
}
